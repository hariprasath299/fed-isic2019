# virtualenv
.venv/
__pycache__/
*.pyc
.pytest_cache/

# data + HF cache: 117 MB feature cache, regenerated by scripts/phase1_cache_features.py
data/

# smoke-test scratch
tmp/

# model checkpoints: finetune runs write ~21 MB per .pt, dozens of runs.
# They stay on local disk for Phase 6 bootstrap CIs; CSVs/configs are the record.
results/*.pt

# run logs
logs/

# aggregate prediction cache: regenerated from checkpoints on demand
results/_cache/
